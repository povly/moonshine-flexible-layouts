{
    "name": "povly/moonshine-flexible-layouts",
    "description": "Flexible content blocks with unlimited nesting for MoonShine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "moonshine/moonshine": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Povly\\FlexibleLayouts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Povly\\FlexibleLayouts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Povly\\FlexibleLayouts\\Providers\\FlexibleLayoutsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "orchestra/testbench": "^11.2"
    }
}
